
# Mautic Environment Configuration

# === DATABASE CONFIGURATION ===
MAUTIC_DB_HOST=mysql.railway.internal
MAUTIC_DB_PORT=3306
MAUTIC_DB_NAME=railway
MAUTIC_DB_USER=root
MAUTIC_DB_PASSWORD=

# === APPLICATION CONFIGURATION ===
MAUTIC_URL=https://mautic-cvn.up.railway.app
APP_ENV=prod
APP_DEBUG=false

# === ADMIN USER CONFIGURATION ===
MAUTIC_ADMIN_EMAIL=calebesouzavasconcelos@gmail.com
MAUTIC_ADMIN_FIRSTNAME=Admin
MAUTIC_ADMIN_LASTNAME=User
MAUTIC_ADMIN_PASSWORD=Admin123!

# === MAIL CONFIGURATION ===
MAUTIC_MAILER_FROM_NAME="Admin User"
MAUTIC_MAILER_FROM_EMAIL=calebesouzavasconcelos@gmail.com
MAUTIC_MAILER_TRANSPORT=smtp
MAUTIC_MAILER_HOST=localhost
MAUTIC_MAILER_PORT=
MAUTIC_MAILER_USER=
MAUTIC_MAILER_PASSWORD=

# === LOCALIZATION ===
MAUTIC_LOCALE=pt_BR
MAUTIC_DEFAULT_TIMEZONE=America/Sao_Paulo

# === SECURITY ===
MAUTIC_SECRET_KEY=
MAUTIC_TRUSTED_PROXIES=*
MAUTIC_TRUSTED_HOSTS=

# === API CONFIGURATION ===
MAUTIC_API_ENABLED=true
MAUTIC_API_ENABLE_BASIC_AUTH=true

# === CACHE & PERFORMANCE ===
MAUTIC_CACHE_PATH=%kernel.cache_dir%
MAUTIC_LOG_PATH=%kernel.logs_dir%
MAUTIC_TMP_PATH=%kernel.cache_dir%
